# Copy to backend/.env (optional). Every value below is a safe default/placeholder.
# API keys are NOT configured here: add them in the Models page, which stores
# them in the OS credential store (Windows Credential Manager).

# SQLite database file (default: backend/data/arbiter.db)
ARBITER_DB_PATH=

# Local Ollama server
ARBITER_OLLAMA_URL=http://127.0.0.1:11434

# Allowed browser origins (comma separated)
ARBITER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "keyring" (default, OS credential store) or "memory" (tests only; keys are lost on restart)
ARBITER_SECRET_BACKEND=keyring

# Provider retries: attempts and base backoff in seconds (doubles each retry)
ARBITER_RETRY_ATTEMPTS=3
ARBITER_RETRY_BASE_DELAY=1.0

# Minimum paired items before a category difference may be called significant
ARBITER_MIN_PAIRED_N=10

# AI-judge calibration thresholds (per criterion)
ARBITER_JUDGE_MIN_N=10
ARBITER_JUDGE_MIN_KAPPA=0.6

# Max request body size in bytes (suite imports)
ARBITER_MAX_IMPORT_BYTES=5242880
